{
  "name": "inherit-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "vitest run --maxWorkers=1 --exclude '**/e2e/**'",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter web typecheck",
    "lint": "pnpm typecheck",
    "shots": "node scripts/shots.mjs",
    "new-pack": "node scripts/new-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.9"
  }
}
